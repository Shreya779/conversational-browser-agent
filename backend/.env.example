# AI Service Configuration - Choose one of the following free options:

# Option 1: Groq (FREE tier with high-quality models)
# Get free API key from: https://console.groq.com/
GROQ_API_KEY=groq_api_key_placeholder_123456

# Option 2: Hugging Face (FREE inference API)
# Get free API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_api_key_placeholder_123456

# Option 3: OpenAI (if you have credits)
OPENAI_API_KEY=your_openai_api_key_here

# Choose which AI service to use: groq, huggingface, or openai
AI_SERVICE=groq

# Server Configuration
HOST=localhost
PORT=8000
DEBUG=True
